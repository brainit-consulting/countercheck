# Copy to .env.local and fill in. Nothing here is a real value.
#
# The first two are read at startup, so the app will not boot without them.
# The rest are only touched when a magic link is actually sent.

# Any Postgres. The app creates its own tables in a `countercheck` schema on
# first use, and Better Auth creates four more in `public`.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string. `openssl rand -base64 32` is fine.
BETTER_AUTH_SECRET=

# Only needed to sign in. Reading the demo ledger needs no account.
RESEND_API_KEY=
SENDER_EMAIL=noreply@yourdomain.example

# Optional. Comma-separated addresses that see the demo/sample switcher, and
# nothing else — this is not a role and is not a permission system.
OWNER_EMAILS=

# Optional. Where the magic link points. Defaults to http://localhost:3000
# outside production, which is wrong if you open the link on a phone.
# BETTER_AUTH_URL=http://localhost:3000
