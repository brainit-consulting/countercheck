node_modules
.next
.data
*.tsbuildinfo
next-env.d.ts
.env*
.vercel

# Agent skills installed as a side effect of `vercel integration add neon`.
# They are editor tooling, not part of the application, and they run with full
# agent permissions — so they are reviewed in place and not carried in the repo
# that gets read on camera.
.agents/
.claude/
skills-lock.json

# The template is the one env file that must be tracked. The README tells a
# reader to copy it, and a README naming a file that is not there is worse than
# no instruction at all. It contains no real value.
!.env.example
